# REPİO(M) sunucu ayarları — ŞABLON. Doldurulmuş kopyası `sunucu/.env` olarak YALNIZ SUNUCUDA durur, DEPOYA GİRMEZ.
# Gizli değerleri üretmek için (bir kez): node anahtar-uret.mjs > .env   → sonra boş kalanları doldur.

# --- Sürüm: çalıştırılacak imaj etiketi (registry.sargin.me/repiom/*:<SURUM>); yayın betiği günceller ---
SURUM=

# --- Adres ---
# Uygulamanın tam adresi (HTTPS, sunucudaki nginx'te): e-posta bağlantıları, yönlendirmeler, mobilin sunucu adresi.
# nginx bu alan adını http://repiom-yonlendirici:80 adresine iletir (nginx-proxy-network ağı).
SITE_URL=https://repiom.com.tr

# --- Gizli değerler (anahtar-uret.mjs üretir) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=
MAGAZA_BILDIRIM_ANAHTARI=
# Yedek şifreleme parolası: AYRICA parola yöneticisinde sakla (kaybolursa yedekler açılamaz)
YEDEK_SIFRESI=

# --- E-posta: sunucudaki mevcut posta sunucusu (SMTP). Ayrı posta konteyneri kurulmaz. ---
# SMTP_HOST: auth konteynerinin erişebildiği ad/adres (aynı Docker ağındaysa konteyner adı).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_GONDEREN=bildirim@repiom.com.tr

# --- Sürekli yedek (Cloudflare R2, AB yetki alanı) ---
YEDEK_ACIK=1
YEDEK_R2_UC=<hesap-kimligi>.eu.r2.cloudflarestorage.com
YEDEK_R2_KOVA=repiom-yedek
YEDEK_R2_ANAHTAR=
YEDEK_R2_GIZLI=
YEDEK_SAATI=03:30

# --- Ödeme, yapay zekâ, mağaza, hata kaydı ---
IYZICO_URL=https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
ANTHROPIC_API_KEY=
YZ_MODEL=claude-sonnet-5-5
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT=
# Sunucu fonksiyonları ve web uygulaması için Sentry adresleri (boşsa hata kaydı kapalı)
SENTRY_DSN=
WEB_SENTRY_DSN=
