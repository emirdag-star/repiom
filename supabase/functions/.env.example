# Sunucu fonksiyonlarının YEREL ortam değişkenleri. `pnpm env:yerel` bu dosyayı supabase/functions/.env olarak kopyalar.
# Aşağıdakiler GERÇEK ANAHTAR DEĞİLDİR: yerelde sahte iyzico (test-iyzico fonksiyonu) kullanılır.
# Gerçek iyzico sandbox'ı için: IYZICO_URL=https://sandbox-api.iyzipay.com ve iyzico panelindeki sandbox anahtarları;
# SAHTE_IYZICO satırını sil. Gerçek anahtarlar hiçbir zaman depoya girmez.
IYZICO_URL=http://kong:8000/functions/v1/test-iyzico
IYZICO_API_KEY=sahte-api-anahtari
IYZICO_SECRET_KEY=sahte-gizli-anahtar
ODEME_DONUS_URL=http://127.0.0.1:55321/functions/v1/odeme-sonuc
IZINLI_KAYNAKLAR=http://localhost:5173,http://localhost:4173,http://localhost:8081
SAHTE_IYZICO=1
SAHTE_IYZICO_GENEL_URL=http://127.0.0.1:55321/functions/v1/test-iyzico
# Yapay zekâ adımı: yerelde sahte Claude servisi (test-claude). Gerçek denemede ANTHROPIC_API_KEY'e gerçek anahtarı yaz,
# ANTHROPIC_BASE_URL ve SAHTE_CLAUDE satırlarını sil.
ANTHROPIC_API_KEY=sahte-anthropic-anahtari
ANTHROPIC_BASE_URL=http://kong:8000/functions/v1/test-claude
YZ_MODEL=claude-sonnet-5-5
SAHTE_CLAUDE=1
# Mobil uygulama içi satın alma: yerelde sahte App Store / Google Play (test-magaza). Gerçek denemede APPLE_* ve
# GOOGLE_* değişkenlerine mağaza panellerinden alınan bilgileri yaz; *_URL ve SAHTE_MAGAZA satırlarını sil.
APPLE_BUNDLE_ID=com.repiom.uygulama
GOOGLE_PACKAGE_NAME=com.repiom.uygulama
APPLE_API_URL=http://kong:8000/functions/v1/test-magaza
APPLE_API_SANDBOX_URL=http://kong:8000/functions/v1/test-magaza
GOOGLE_API_URL=http://kong:8000/functions/v1/test-magaza
GOOGLE_TOKEN_URL=http://kong:8000/functions/v1/test-magaza/token
MAGAZA_BILDIRIM_ANAHTARI=sahte-bildirim-anahtari
SAHTE_MAGAZA=1
